# Required: an existing domain/subdomain whose DNS points to this Droplet.
# Enter only the hostname (no https://, port, or path).
DOMAIN=larch-web.dr-xas.org

# Release identity. The remote release runner replaces both with the exact
# 40-character commit; set them explicitly for a traceable manual rollout.
LARCH_RELEASE_TAG=manual
XRAYLARCH_GIT_REVISION=unknown

# Per-upload and analysis limits. These are the app's current defaults.
XRAYLARCH_MAX_UPLOAD_BYTES=50000000
XRAYLARCH_MAX_POINTS=250000
XRAYLARCH_MAX_COLUMNS=256
XRAYLARCH_MAX_NFFT=262144
